<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0-windows8</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="data\**" />
	  <Content Remove="data\**" />
	  <EmbeddedResource Remove="data\**" />
	  <None Remove="data\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Autodesk.DataExchange" Version="7.5.0-beta" />
		<PackageReference Include="Autodesk.DataExchange.GeometryDefinitions" Version="0.9.3" />
		<PackageReference Include="SharpGLTF.Toolkit" Version="1.0.6" />
	</ItemGroup>

	<Target Name="IncludeNativeServicesInPublish" BeforeTargets="ComputeFilesToPublish">
		<ItemGroup>
			<_GeometryUtilitiesServiceFiles Include="$(OutDir)GeometryUtilitiesService\**\*.*" />
			<_ParameterServiceFiles Include="$(OutDir)ParameterService\**\*.*" />
			<_FeatureFlagManagerFiles Include="$(OutDir)FeatureFlagManager\**\*.*" />

			<ResolvedFileToPublish Include="@(_GeometryUtilitiesServiceFiles)">
				<RelativePath>GeometryUtilitiesService\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			</ResolvedFileToPublish>
			<ResolvedFileToPublish Include="@(_ParameterServiceFiles)">
				<RelativePath>ParameterService\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			</ResolvedFileToPublish>
			<ResolvedFileToPublish Include="@(_FeatureFlagManagerFiles)">
				<RelativePath>FeatureFlagManager\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			</ResolvedFileToPublish>
		</ItemGroup>
	</Target>

</Project>
