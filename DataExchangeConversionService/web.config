<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
	On Azure App Service (Windows) IIS sits in front of Kestrel. The WebDAV module
	is registered by default and intercepts OPTIONS requests, returning 405 before
	ASP.NET Core's CORS middleware can handle the preflight. Remove it so OPTIONS
	requests flow through to the app.
  -->
  <system.webServer>
	<modules>
	  <remove name="WebDAVModule" />
	</modules>
	<handlers>
	  <remove name="WebDAV" />
	</handlers>
  </system.webServer>
</configuration>
